# Copy to ignored .env.local. Leave auth disabled until a free project is configured.
# Project Settings / Connect: use the PUBLISHABLE key, never a secret/service key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Trusted application origin: never derived from an incoming Host header.
APP_URL=http://localhost:3000
# Enable only after owner/team email testing and exact redirect/template setup.
AUTH_EMAIL_ENABLED=false

# T05 local narration proof. Leave disabled; use a restricted Free account API key.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional absolute paths; Windows defaults use the bundled Remotion tools.
FFMPEG_PATH=
FFPROBE_PATH=
